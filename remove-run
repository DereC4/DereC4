function Remove-McRun {
    <#
    .SYNOPSIS
    Recursively finds and deletes 'run' folders that belong to Minecraft mod projects.
    #>
    
    # Get all folders named exactly 'run' from the current directory downwards
    $runDirs = Get-ChildItem -Path . -Directory -Recurse -Filter "run"
    $deletedCount = 0
    
    foreach ($dir in $runDirs) {
        $parentPath = Split-Path $dir.FullName -Parent
        
        # Safety Check 1: Does the parent folder have Gradle build files?
        $hasGradleFiles = (Test-Path "$parentPath\build.gradle") -or (Test-Path "$parentPath\gradlew.bat")
        
        # Safety Check 2: Does the run folder contain typical Minecraft files?
        $hasMcFiles = (Test-Path "$($dir.FullName)\config") -or 
                      (Test-Path "$($dir.FullName)\logs") -or 
                      (Test-Path "$($dir.FullName)\eula.txt")
        
        if ($hasGradleFiles -or $hasMcFiles) {
            Write-Host "Removing MC run folder: $($dir.FullName)" -ForegroundColor Yellow
            Remove-Item -Path $dir.FullName -Recurse -Force
            $deletedCount++
        } else {
            Write-Host "Skipping (Not a recognized MC mod folder): $($dir.FullName)" -ForegroundColor DarkGray
        }
    }
    
    Write-Host "Finished! Deleted $deletedCount run folder(s)." -ForegroundColor Green
}
